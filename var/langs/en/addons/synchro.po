msgctxt "Languages::synchro.cron_script_type_tooltip"
msgid ""
"<b>Examples</b>:\n"
"\n"
"From admin area:\n"
"<b>console.script --param=val</b> => php ./admin.php --dispatch=console.script --param=val\n"
"\n"
"From customer area:\n"
"<b>console.script --param=val</b> => php ./index.php --dispatch=console.script --param=val\n"
"\n"
"Custom command:\n"
"<b>php ./admin.php --dispatch=console.script --param=val</b>"
msgstr ""
"<b>Examples</b>:\n"
"\n"
"From admin area:\n"
"<b>console.script --param=val</b> => php ./admin.php --dispatch=console.script --param=val\n"
"\n"
"From customer area:\n"
"<b>console.script --param=val</b> => php ./index.php --dispatch=console.script --param=val\n"
"\n"
"Custom command:\n"
"<b>php ./admin.php --dispatch=console.script --param=val</b>"

